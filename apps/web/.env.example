# Copy to .env.local (never commit it).

# Public origin of this web app (no trailing slash). Auth cookies and CSRF checks use it.
APP_ORIGIN=http://localhost:3000

# Postgres. Local: `docker compose up -d db` from the repo root. Managed: add ?sslmode=require
DATABASE_URL=postgres://lct:lct_dev_password@localhost:5432/lct

# Three DIFFERENT secrets, each from: openssl rand -base64 48
# Signs auth sessions and encrypts 2FA secrets.
BETTER_AUTH_SECRET=
# Same value as TICKET_SECRET in apps/gateway/.env (call tickets).
GATEWAY_TICKET_SECRET=
# Same value as INTERNAL_API_SECRET in apps/gateway/.env (server-to-server voice calls).
INTERNAL_API_SECRET=

# Where browsers reach the gateway WebSocket. Must be wss:// in production.
GATEWAY_PUBLIC_URL=ws://localhost:8787
# Where this server reaches the gateway's internal voice API. Must be https:// in production.
GATEWAY_INTERNAL_URL=http://localhost:8787

TICKET_ISSUER=lct-web
TICKET_AUDIENCE=lct-gateway

# Email (verification + password reset) via Resend. Required in production.
# In development, leave empty: links are printed in the terminal running `pnpm dev`.
RESEND_API_KEY=
EMAIL_FROM="Live Call Translator <no-reply@your-domain.com>"
