# Copy to .env.local (never commit it).
# Public origin of this web app. The ticket endpoint only accepts requests from this origin.
APP_ORIGIN=http://localhost:3000
# Where browsers reach the gateway. Must be wss:// in production.
GATEWAY_PUBLIC_URL=ws://localhost:8787
# Same value as TICKET_SECRET in apps/gateway/.env. Server-only: never prefix with NEXT_PUBLIC_.
GATEWAY_TICKET_SECRET=
TICKET_ISSUER=lct-web
TICKET_AUDIENCE=lct-gateway
# PHASE 1 ONLY: lets you use the app before real sign-in exists. Ignored when NODE_ENV=production.
DEV_AUTH_BYPASS=true
