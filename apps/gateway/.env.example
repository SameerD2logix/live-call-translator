# Copy to .env (never commit .env). All secrets live ONLY on the gateway.
NODE_ENV=development
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info
# Set to true when running behind Render/Railway's proxy (needed for HTTPS detection and per-IP limits)
TRUST_PROXY=false

# Comma-separated list of web origins allowed to open a WebSocket. Use https:// origins in production.
ALLOWED_ORIGINS=http://localhost:3000

# Shared with apps/web (GATEWAY_TICKET_SECRET). Generate with: openssl rand -base64 48
TICKET_SECRET=
TICKET_ISSUER=lct-web
TICKET_AUDIENCE=lct-gateway
# Signs the web app's server-to-server voice calls. Shared with apps/web (same name there).
# Generate separately: openssl rand -base64 48   (must NOT equal TICKET_SECRET)
INTERNAL_API_SECRET=

# Providers: elevenlabs | anthropic | mock. Use "mock" for all four to run with no API keys.
STT_PROVIDER=elevenlabs
TRANSLATION_PROVIDER=anthropic
TTS_PROVIDER=elevenlabs
VOICE_CLONE_PROVIDER=elevenlabs

ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2_realtime
# eleven_flash_v2_5 = lowest latency. eleven_v4_turbo = more expressive, ~100 ms (retrain older clones for v4).
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Phase 2: each user speaks with their own clone. The voice id arrives in the signed call ticket.
# Languages besides Urdu that may appear in speech (code-mixing). Leave empty to disable.
STT_SECONDARY_LANGUAGES=en
# Pause length (seconds) that ends a sentence. Lower = faster but more mid-sentence cuts.
VAD_SILENCE_SECS=0.7

ANTHROPIC_API_KEY=
TRANSLATION_MODEL=claude-haiku-5-5

# Abuse and bill protection
DAILY_MINUTES_QUOTA=120
MAX_SESSION_MINUTES=60
