# Copy to .env (never commit .env). All secrets live ONLY on the gateway.
NODE_ENV=development
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info
# Number of reverse proxies in front of the gateway: 1 on Render/Railway/Fly, 0 when running locally.
# Exactly this many hops are trusted, so clients can't fake their IP to dodge rate limits.
TRUSTED_PROXY_HOPS=0

# Comma-separated list of web origins allowed to open a WebSocket. Use https:// origins in production.
ALLOWED_ORIGINS=http://localhost:3000

# Shared with apps/web (GATEWAY_TICKET_SECRET). Generate with: openssl rand -base64 48
TICKET_SECRET=
TICKET_ISSUER=lct-web
TICKET_AUDIENCE=lct-gateway
# Signs the web app's server-to-server voice calls. Shared with apps/web (same name there).
# Generate separately: openssl rand -base64 48   (must NOT equal TICKET_SECRET)
INTERNAL_API_SECRET=
# Rotating a secret: set the new value above, the old one here, deploy the gateway, then update the web
# app, then remove the old value a few minutes later. Tokens are short-lived, so nobody is signed out.
TICKET_SECRET_PREVIOUS=
INTERNAL_API_SECRET_PREVIOUS=

# Providers. Use "mock" for all five to run with no API keys.
STT_PROVIDER=elevenlabs
TRANSLATION_PROVIDER=anthropic
# elevenlabs = text-to-speech stream (Flash v2.5) | elevenlabs-dialogue = Text to Dialogue stream (Eleven v4)
TTS_PROVIDER=elevenlabs
VOICE_CLONE_PROVIDER=elevenlabs
INCOMING_TTS_PROVIDER=elevenlabs-dialogue

ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2_realtime
# eleven_flash_v2_5 = lowest latency (default). For eleven_v4_turbo (more expressive) ALSO set
# TTS_PROVIDER=elevenlabs-dialogue: v4 models are served through the Text to Dialogue API.
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Phase 2: each user speaks with their own clone. The voice id arrives in the signed call ticket.
# Languages besides Urdu that may appear in speech (code-mixing). Leave empty to disable.
STT_SECONDARY_LANGUAGES=en
# Pause length (seconds) that ends a sentence. Lower = faster but more mid-sentence cuts.
VAD_SILENCE_SECS=0.7

# ---- Accuracy (Phase 4) ----
# Send each user's glossary to speech recognition as keyterms (about 20% more STT cost for that audio).
STT_USE_KEYTERMS=true
# Wait this long (ms) for the end of a sentence that stopped mid-clause, e.g. before the Urdu verb. 0 = off.
MERGE_INCOMPLETE_MS=2500
# Check that voice-cloning samples read the prompted sentences (blocks cloning other people's audio).
VOICE_SCRIPT_CHECK=true

# ---- Incoming direction (the client's English → Urdu for you) ----
INCOMING_VAD_SILENCE_SECS=0.6
# Urdu speech needs the Eleven v4 family (Flash v2.5 has no Urdu).
INCOMING_TTS_MODEL=eleven_v4_turbo
# A stock voice from your ElevenLabs library that sounds natural in Urdu (test a few).
# Leave empty to offer Urdu subtitles only. Never clone the client's voice.
INCOMING_VOICE_ID=

ANTHROPIC_API_KEY=
TRANSLATION_MODEL=claude-haiku-5-5

# Abuse and bill protection. Both directions count: a 60-minute call with subtitles uses up to 120.
DAILY_MINUTES_QUOTA=240
MAX_SESSION_MINUTES=60
